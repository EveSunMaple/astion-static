---
import { USER_FOOTER_SOCIAL_ICONS, USER_NAME, USER_SITE } from "@config";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-base-content/10 py-8 text-[13px] text-base-content/50">
  <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
    <p>
      © {year}
      <a href={USER_SITE} target="_blank" rel="noopener noreferrer" class="hover:text-base-content">{USER_NAME}</a>
      · Powered by
      <a
        href="https://github.com/EveSunMaple/astion-static"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-base-content">Astion</a
      >
    </p>
    <div class="flex items-center gap-1">
      {
        USER_FOOTER_SOCIAL_ICONS.map((icon) => (
          <a
            href={icon.href}
            aria-label={icon.ariaLabel}
            title={icon.title}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-xs btn-square text-base-content/40 hover:text-base-content"
          >
            <Icon name={icon.svg} class="h-4 w-4" />
          </a>
        ))
      }
    </div>
  </div>
</footer>
