---
import CoverImage from "@components/widgets/CoverImage.astro";
import type { PostData } from "@interfaces/data";
import { Icon } from "astro-icon/components";

export interface MainCardProps extends PostData {
  textOverlay?: string;
  icon?: string;
}

const { title, description, image, icon } = Astro.props as MainCardProps;
---

<div class="w-full">
  {
    image && (
      <div class="page-cover">
        <CoverImage src={image} alt={title} width={1200} height={420} loading="eager" />
      </div>
    )
  }

  <header class="pb-6 pt-8">
    {icon && <Icon name={icon} class="page-icon-svg" />}
    <h1 class="detail-title">{title}</h1>
    {description && <p class="page-header-description">{description}</p>}
  </header>

  <slot />
</div>
