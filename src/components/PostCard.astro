---
import { t } from "@config";
import type { PostData } from "@interfaces/data";
import dayjs from "@utils/dayjs";
import CoverImage from "./widgets/CoverImage.astro";

const {
  title,
  image,
  pubDate,
  description,
  badge,
  categories = [],
  tags = [],
  word,
  time,
  priority = false,
  url = decodeURIComponent(Astro.url.toString()),
} = Astro.props as PostData;

const displayDate = pubDate ? dayjs(pubDate).format("YYYY/MM/DD") : "";
const hasMeta =
  Boolean(badge) ||
  Boolean(word) ||
  Boolean(time) ||
  categories.length > 0 ||
  tags.length > 0;
---

<a href={url} class="doc-row group">
  <div class="doc-row-date">{displayDate}</div>
  <div class="doc-row-body">
    <div class="doc-row-title">{title}</div>
    {description && <p class="doc-row-description">{description}</p>}
    {
      hasMeta && (
        <div class="doc-row-meta">
          {badge && <span class="pill">{badge}</span>}
          {word && (
            <span>
              {word} {t("label.wordCount")}
            </span>
          )}
          {time && (
            <span>
              {time} {t("label.readTime")}
            </span>
          )}
          {categories.map((category) => (
            <span class="pill">{category}</span>
          ))}
          {tags.map((tag) => (
            <span class="pill">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  {
    image && (
      <div class="thumb hidden sm:block">
        <CoverImage
          src={image}
          alt={title}
          width={320}
          height={200}
          loading={priority ? "eager" : "lazy"}
        />
      </div>
    )
  }
</a>
