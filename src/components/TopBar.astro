---
import { SITE_TITLE } from "@config";
import { Icon } from "astro-icon/components";
import ThemeToggle from "./widgets/ThemeToggle.astro";

const { title } = Astro.props as { title?: string };
---

<header
  class="sticky top-0 z-30 flex h-12 items-center justify-between gap-4 border-b border-line bg-bg/85 px-4 backdrop-blur md:px-6"
>
  <div class="flex min-w-0 items-center gap-1">
    <button
      id="sidebar-toggle"
      class="button lg:hidden"
      data-variant="ghost"
      data-size="icon"
      aria-label="Open navigation"
      aria-controls="app-sidebar"
      aria-expanded="false"
    >
      <Icon name="lucide:menu" class="h-4 w-4" />
    </button>
    <button
      id="sidebar-collapse"
      class="button hidden lg:inline-flex"
      data-variant="ghost"
      data-size="icon"
      aria-label="Toggle sidebar"
    >
      <Icon name="lucide:panel-left" class="h-4 w-4" />
    </button>

    <nav class="ml-2 flex min-w-0 items-center gap-2 text-[15px]" aria-label="Breadcrumb">
      <a
        href="/"
        class="max-w-36 truncate rounded-sm px-1.5 py-0.5 text-muted transition-colors duration-150 ease-standard hover:text-fg"
      >
        {SITE_TITLE}
      </a>
      {
        title && (
          <>
            <span class="text-meta">/</span>
            <span id="breadcrumb-current" class="max-w-56 truncate px-1.5 text-fg">
              {title}
            </span>
          </>
        )
      }
    </nav>
  </div>

  <div class="flex flex-none items-center gap-1">
    <a
      href="/blog/search"
      class="button text-muted"
      data-variant="ghost"
      data-size="icon"
      aria-label="Search"
      title="Search"
    >
      <Icon name="lucide:search" class="h-4 w-4" />
    </a>
    <ThemeToggle />
  </div>
</header>
