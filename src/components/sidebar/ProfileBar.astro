---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE_MENU, SITE_TITLE, USER_AVATAR, USER_NAME } from "../../config";
import SearchBar from "./SearchBar.astro";

const currentPath = Astro.url.pathname;
---

<a
  href="/"
  class="flex items-center gap-3 rounded-sm px-2 py-2 transition-colors duration-150 ease-standard hover:bg-surface-2"
>
  <Image
    class="rounded-full"
    format="webp"
    width={72}
    height={72}
    src={USER_AVATAR}
    alt={`${USER_NAME} avatar`}
    loading="eager"
  />
  <span class="min-w-0">
    <span class="block truncate text-[15px] font-semibold text-fg">{USER_NAME}</span>
    <span class="block truncate text-[13px] text-meta">{SITE_TITLE}</span>
  </span>
</a>

<div class="mt-3">
  <SearchBar />
</div>

<nav class="mt-3 border-t border-line-soft pt-3" aria-label="Main">
  <ul class="flex flex-col gap-0.5">
    {
      SITE_MENU.map((item) => (
        <li>
          {item.subItems ? (
            <details open={currentPath.startsWith(item.href)}>
              <summary class="side-link cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <Icon name={item.svg} class="h-4 w-4 flex-none" />
                <span class="flex-1 truncate">{item.text}</span>
                <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 flex-none opacity-60" />
              </summary>
              <ul class="side-group flex flex-col gap-0.5">
                {item.subItems.map((subItem) => (
                  <li>
                    <a
                      class="side-link"
                      id={`header-${subItem.id}`}
                      href={subItem.href}
                      target={subItem.target || "_self"}
                      aria-label={subItem.text}
                      aria-current={currentPath === subItem.href ? "page" : undefined}
                    >
                      <Icon name={subItem.svg} class="h-4 w-4 flex-none opacity-70" />
                      <span class="truncate">{subItem.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              class="side-link"
              id={item.id}
              href={item.href}
              target={item.target || "_self"}
              aria-label={item.text}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              <Icon name={item.svg} class="h-4 w-4 flex-none" />
              <span class="truncate">{item.text}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
