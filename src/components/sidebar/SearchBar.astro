---
import { t } from "@config";
import { Icon } from "astro-icon/components";
---

<form action="/blog/search" method="get" class="relative w-full">
  <Icon
    name="lucide:search"
    class="pointer-events-none absolute top-1/2 left-2.5 h-4 w-4 -translate-y-1/2 text-base-content/40"
  />
  <input
    type="text"
    name="q"
    placeholder={t("label.searchPlaceholder") || "Search..."}
    class="w-full rounded-md border-0 bg-base-200 py-1.5 pr-3 pl-8 text-sm text-base-content outline-none placeholder:text-base-content/40 focus:ring-2 focus:ring-primary/40"
    aria-label={t("label.search") || "Search"}
  />
</form>

<script>
  // Focus search input when pressing '/' key
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (e.key === "/" && target && target.tagName !== "INPUT" && target.tagName !== "TEXTAREA") {
      e.preventDefault();
      const searchInput = document.querySelector('input[name="q"]');
      if (searchInput) {
        (searchInput as HTMLInputElement).focus();
      }
    }
  });
</script>
