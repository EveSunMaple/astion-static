---
import { DATE_FORMAT, t, USER_NAME } from "@config";
import type { PostData } from "@interfaces/data";
import dayjs from "@utils/dayjs";
import { Icon } from "astro-icon/components";
import PostFilter from "./PostFilter.astro";

const {
  title,
  url,
  pubDate,
  badge,
  categories = [],
  tags = [],
  word,
  time,
} = Astro.props as PostData;
const displayDate = pubDate ? dayjs(pubDate).format(DATE_FORMAT) : "";
const socialLinks = [
  {
    name: "X (Twitter)",
    icon: "ri:twitter-x-line",
    url: `https://twitter.com/intent/tweet/?text=${encodeURIComponent(title)}&url=${encodeURIComponent(String(url))}`,
  },
  {
    name: "Telegram",
    icon: "ri:telegram-line",
    url: `https://telegram.me/share/url?text=${encodeURIComponent(title)}&url=${encodeURIComponent(String(url))}`,
  },
  {
    name: "Reddit",
    icon: "ri:reddit-line",
    url: `https://reddit.com/submit/?url=${encodeURIComponent(String(url))}&title=${encodeURIComponent(title)}`,
  },
  {
    name: "Email",
    icon: "ri:mail-line",
    url: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(String(url))}`,
  },
];
---

<hr class="my-8 border-base-content/10" />

<div class="flex flex-col gap-3 pb-4 text-xs text-base-content/50">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    {displayDate && <span>{displayDate}</span>}
    {badge && <span>{badge}</span>}
    {
      word && time && (
        <span>
          {word} {t("label.wordCount")} · {time} {t("label.readTime")}
        </span>
      )
    }
    <PostFilter categories={categories} tags={tags} />
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p>
      © {USER_NAME} ·
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-base-content/30 underline-offset-2 hover:text-base-content"
      >
        CC BY-NC-SA 4.0
      </a>
    </p>
    <button
      class="btn btn-ghost btn-sm gap-1 text-base-content/60"
      onclick="share_modal.showModal()"
    >
      {t("label.share")}
      <Icon name="ri:share-line" class="h-4 w-4" />
    </button>
  </div>
</div>

<dialog id="share_modal" class="modal">
  <div class="modal-box max-w-sm bg-base-100">
    <h3 class="mb-3 text-sm font-semibold">{t("label.share")}</h3>
    <div class="flex flex-wrap gap-2">
      {
        socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm gap-1"
          >
            <Icon name={social.icon} class="h-4 w-4" />
            {social.name}
          </a>
        ))
      }
    </div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost btn-sm">Close</button>
      </form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
