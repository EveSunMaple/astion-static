---
import { t } from "@config";
import type { TOCBarProps } from "@interfaces/data";
import { Icon } from "astro-icon/components";

const { headings = [], showTOC = true } = Astro.props as TOCBarProps;
---

{showTOC && headings.length > 0 && (
  <>
    <button
      id="mobile-toc-button"
      aria-label={t("label.tableOfContents")}
      aria-hidden="true"
      tabindex="-1"
      class="button fixed right-6 bottom-20 z-50 border border-line bg-bg/90 opacity-0 invisible shadow-raised backdrop-blur transition-all duration-200 ease-standard lg:hidden"
      data-variant="ghost"
      data-size="icon"
      onclick="mobile_toc_modal.showModal()"
    >
      <Icon name="lucide:list" class="h-4 w-4" />
    </button>

    <dialog id="mobile_toc_modal" class="modal lg:hidden">
      <div class="dialog-card w-10/12 max-w-md p-4">
        <div class="flex items-center justify-between border-b border-line-soft pb-3">
          <h3 class="text-[15px] font-semibold">{t("label.tableOfContents")}</h3>
          <form method="dialog">
            <button class="button text-muted" data-variant="ghost" data-size="icon" aria-label={t("label.close")}>
              <Icon name="lucide:x" class="h-4 w-4" />
            </button>
          </form>
        </div>
        <div class="max-h-[70vh] overflow-auto pt-3">
          <ul>
            {headings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="mobile-toc-link block truncate rounded-sm px-2 py-1.5 text-[14px] text-muted transition-colors duration-150 ease-standard hover:bg-surface-2 hover:text-fg"
                  style={`margin-left: ${(heading.depth - 1) * 12}px`}
                  data-mobile-heading-id={heading.slug}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>{t("label.close")}</button>
      </form>
    </dialog>
  </>
)}

<script>
  let cleanup: (() => void) | null = null;

  document.addEventListener("app:page", () => {
    cleanup?.();
    cleanup = null;

    const tocButton = document.getElementById("mobile-toc-button");
    if (!tocButton) return;

    const tocLinks = document.querySelectorAll(".mobile-toc-link");
    const headings = document.querySelectorAll("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]");

    let scrollTimeout: ReturnType<typeof setTimeout> | null = null;

    const handleScroll = () => {
      if (scrollTimeout) return;

      scrollTimeout = setTimeout(() => {
        const currentScrollY = window.scrollY;

        if (currentScrollY > 400) {
          tocButton.classList.remove("opacity-0", "invisible");
          tocButton.classList.add("opacity-100", "visible");
          tocButton.setAttribute("aria-hidden", "false");
          tocButton.tabIndex = 0;
        } else {
          tocButton.classList.remove("opacity-100", "visible");
          tocButton.classList.add("opacity-0", "invisible");
          tocButton.setAttribute("aria-hidden", "true");
          tocButton.tabIndex = -1;
        }

        if (tocLinks.length > 0 && headings.length > 0) {
          updateActiveHeading();
        }

        scrollTimeout = null;
      }, 100);
    };

    const updateActiveHeading = () => {
      let activeHeadingId = null;
      const offset = 100;

      for (let i = headings.length - 1; i >= 0; i--) {
        const heading = headings[i];
        const rect = heading.getBoundingClientRect();

        if (rect.top <= offset) {
          activeHeadingId = heading.id;
          break;
        }
      }

      tocLinks.forEach((link) => {
        const headingId = link.getAttribute("data-mobile-heading-id");
        if (headingId === activeHeadingId) {
          link.classList.add("bg-surface-2", "text-fg");
        } else {
          link.classList.remove("bg-surface-2", "text-fg");
        }
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    cleanup = () => {
      window.removeEventListener("scroll", handleScroll);
      if (scrollTimeout) {
        clearTimeout(scrollTimeout);
      }
    };
  });
</script>
