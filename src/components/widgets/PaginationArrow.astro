---
import type { PaginationArrowProps } from "@interfaces/data";
import { Icon } from "astro-icon/components";

const { url, direction, label } = Astro.props as PaginationArrowProps;
---

{
  url ? (
    <a href={url} aria-label={label} class="btn btn-ghost btn-sm gap-1 px-2 font-normal text-base-content/60">
      {direction === "prev" && <Icon name="ri:arrow-left-s-line" class="h-4 w-4" />}
      <span class="hidden lg:inline">{label}</span>
      {direction === "next" && <Icon name="ri:arrow-right-s-line" class="h-4 w-4" />}
    </a>
  ) : (
    <span class="btn btn-ghost btn-sm gap-1 px-2 font-normal text-base-content/30" aria-disabled="true" aria-label={label}>
      {direction === "prev" && <Icon name="ri:arrow-left-s-line" class="h-4 w-4" />}
      <span class="hidden lg:inline">{label}</span>
      {direction === "next" && <Icon name="ri:arrow-right-s-line" class="h-4 w-4" />}
    </span>
  )
}
