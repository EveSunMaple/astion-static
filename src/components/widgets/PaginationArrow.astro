---
import type { PaginationArrowProps } from "@interfaces/data";
import { Icon } from "astro-icon/components";

const { url, direction, label } = Astro.props as PaginationArrowProps;
---

{
  url ? (
    <a href={url} aria-label={label} class="button gap-1.5 px-2 text-muted" data-variant="ghost" data-size="sm">
      {direction === "prev" && <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />}
      <span class="hidden lg:inline">{label}</span>
      {direction === "next" && <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />}
    </a>
  ) : (
    <span class="button gap-1.5 px-2 opacity-40" data-variant="ghost" data-size="sm" aria-disabled="true">
      {direction === "prev" && <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />}
      <span class="hidden lg:inline">{label}</span>
      {direction === "next" && <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />}
    </span>
  )
}
