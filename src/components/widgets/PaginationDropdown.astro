---
import type { PaginationDropdownProps } from "@interfaces/data";

const { hiddenPages, current, baseUrl } =
  Astro.props as PaginationDropdownProps;
---

<div class="dropdown dropdown-top join-item">
  <div
    tabindex="0"
    role="button"
    aria-haspopup="menu"
    aria-label="More pages"
    class="btn btn-ghost btn-sm join-item px-2 font-normal text-base-content/60"
  >
    ...
  </div>
  <ul
    class="dropdown-content menu z-[100] mt-1 w-auto rounded-md border border-base-content/10 bg-base-100 p-1 shadow-lg"
  >
    {
      hiddenPages.map((page) => (
        <li class="w-full">
          <a
            href={page === 1 ? baseUrl : `${baseUrl}/${page}`}
            class:list={[
              "py-1 px-3 text-center text-sm",
              page === current && "bg-base-200 text-base-content",
            ]}
          >
            {page}
          </a>
        </li>
      ))
    }
  </ul>
</div>
