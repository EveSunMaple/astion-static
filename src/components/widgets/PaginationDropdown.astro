---
import type { PaginationDropdownProps } from "@interfaces/data";

const { hiddenPages, current, baseUrl } =
  Astro.props as PaginationDropdownProps;
---

<details class="relative">
  <summary
    class="button min-w-8 cursor-pointer list-none px-2 text-muted [&::-webkit-details-marker]:hidden"
    data-variant="ghost"
    data-size="sm"
    aria-label="More pages"
  >
    ...
  </summary>
  <ul
    class="absolute bottom-full left-1/2 z-[100] mb-1 -translate-x-1/2 rounded-sm border border-line bg-bg p-1 shadow-raised"
  >
    {
      hiddenPages.map((page) => (
        <li>
          <a
            href={page === 1 ? baseUrl : `${baseUrl}/${page}`}
            class:list={[
              "block min-w-8 rounded-sm px-2 py-1 text-center text-[14px] text-muted hover:bg-surface-2 hover:text-fg",
              page === current && "bg-surface-2 text-fg",
            ]}
          >
            {page}
          </a>
        </li>
      ))
    }
  </ul>
</details>
