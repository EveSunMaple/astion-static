---
import type { PaginationNumberProps } from "@interfaces/data";

const {
  number,
  current,
  baseUrl,
  isOnly = false,
} = Astro.props as PaginationNumberProps;
const href = number === 1 ? baseUrl : `${baseUrl}/${number}`;
---

<a
  href={href}
  title={`Page ${number}`}
  aria-label={`Page ${number}`}
  aria-current={number === current ? "page" : undefined}
  class:list={["button min-w-8 px-2", number === current ? "" : "text-muted", isOnly && "w-8"]}
  data-variant="ghost"
  data-size="sm"
>
  {number}
</a>
