---
import type { PaginationNumberProps } from "@interfaces/data";

const {
  number,
  current,
  baseUrl,
  isOnly = false,
} = Astro.props as PaginationNumberProps;
const href = number === 1 ? baseUrl : `${baseUrl}/${number}`;
---

<a
  href={href}
  title={`Page ${number}`}
  aria-label={`Page ${number}`}
  aria-current={number === current ? "page" : undefined}
  class:list={[
    "join-item btn btn-sm min-w-9 px-2 font-normal",
    number === current
      ? "bg-base-200 text-base-content"
      : "btn-ghost text-base-content/60",
    isOnly && "rounded-btn",
  ]}
>
  {number}
</a>
