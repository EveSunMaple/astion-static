---
import { t } from "@config";
import type { PostData } from "@interfaces/data";
import { Icon } from "astro-icon/components";

const { pubDate, badge, word, time } = Astro.props as PostData;
---

<div class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-1 text-[14px] text-meta">
  {
    pubDate && (
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
        <span class="font-variant-numeric tabular-nums">{pubDate}</span>
      </span>
    )
  }
  {
    badge && (
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:bookmark" class="h-3.5 w-3.5" />
        <span>{badge}</span>
      </span>
    )
  }
  {
    (word || time) && (
      <span class="inline-flex items-center gap-1.5 tabular-nums">
        <span>
          {word} {t("label.wordCount")}
        </span>
        <span class="h-3 w-px bg-line-soft" />
        <span>
          {time} {t("label.readTime")}
        </span>
      </span>
    )
  }
</div>
