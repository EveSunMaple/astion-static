---
import { t } from "@config";
import type { PostData } from "@interfaces/data";
import { Icon } from "astro-icon/components";

const { pubDate, badge, word, time } = Astro.props as PostData;
---

<div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-base-content/50">
  {
    pubDate && (
      <span class="inline-flex items-center gap-1">
        <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
        <span>{pubDate}</span>
      </span>
    )
  }
  {
    badge && (
      <span class="inline-flex items-center gap-1">
        <Icon name="lucide:bookmark" class="h-3.5 w-3.5" />
        <span>{badge}</span>
      </span>
    )
  }
  {
    (word || time) && (
      <span>
        {word} {t("label.wordCount")} · {time} {t("label.readTime")}
      </span>
    )
  }
</div>
