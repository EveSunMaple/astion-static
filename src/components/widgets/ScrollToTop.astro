---
import { Icon } from "astro-icon/components";
---

<button
  id="scroll-to-top"
  aria-label="Scroll to top"
  aria-hidden="true"
  tabindex="-1"
  class="button fixed right-6 bottom-6 z-50 border border-line bg-bg/90 opacity-0 invisible shadow-raised backdrop-blur transition-all duration-200 ease-standard"
  data-variant="ghost"
  data-size="icon"
>
  <Icon name="lucide:arrow-up" class="h-4 w-4" />
</button>

<script>
  let cleanup: (() => void) | null = null;

  document.addEventListener("app:page", () => {
    cleanup?.();
    cleanup = null;

    const scrollButton = document.getElementById("scroll-to-top");
    if (!scrollButton) return;

    const toggleVisibility = () => {
      if (window.scrollY > 400) {
        scrollButton.classList.remove("opacity-0", "invisible");
        scrollButton.classList.add("opacity-100", "visible");
        scrollButton.setAttribute("aria-hidden", "false");
        scrollButton.tabIndex = 0;
      } else {
        scrollButton.classList.remove("opacity-100", "visible");
        scrollButton.classList.add("opacity-0", "invisible");
        scrollButton.setAttribute("aria-hidden", "true");
        scrollButton.tabIndex = -1;
      }
    };

    const onClick = () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    };

    toggleVisibility();

    window.addEventListener("scroll", toggleVisibility, { passive: true });
    scrollButton.addEventListener("click", onClick);

    cleanup = () => {
      window.removeEventListener("scroll", toggleVisibility);
      scrollButton.removeEventListener("click", onClick);
    };
  });
</script>
