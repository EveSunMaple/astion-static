---
import { USER_NAME, USER_SITE } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = [
  {
    name: "Astion",
    description: "A Notion-powered blog template built with Astro.",
    url: "https://github.com/EveSunMaple/astion-static",
  },
  {
    name: "Frosti",
    description: "A clean, elegant, and fast static blog template.",
    url: "https://github.com/EveSunMaple/Frosti",
  },
  {
    name: "rehype-smart-links",
    description:
      "A rehype plugin that styles internal and external links differently.",
    url: "https://github.com/EveSunMaple/rehype-smart-links",
  },
];

const stack = [
  "Astro",
  "TypeScript",
  "JavaScript",
  "Node.js",
  "React",
  "Tailwind CSS",
  "Python",
  "C++",
  "C#",
  "Git",
];

const links = [
  {
    label: "GitHub",
    description: "Open source projects and experiments",
    url: "https://github.com/EveSunMaple",
    icon: "ri:github-line",
  },
  {
    label: "X (Twitter)",
    description: "Short notes and updates",
    url: "https://x.com/EveSunMaple",
    icon: "ri:twitter-x-line",
  },
  {
    label: "Email",
    description: "contact.evesunmaple@outlook.com",
    url: "mailto:contact.evesunmaple@outlook.com",
    icon: "ri:mail-line",
  },
  {
    label: "Website",
    description: USER_SITE,
    url: USER_SITE,
    icon: "ri:global-line",
  },
];
---

<BaseLayout title="About">
  <MainCard
    title="About"
    icon="ri:user-line"
    description="Developer, open-source enthusiast, and creator of the Astion and Frosti projects."
  >
    <div class="notion-content">
      <p>
        Hello! I'm {USER_NAME}, a developer focused on building elegant, fast and content-focused
        websites. I'm the creator of <a href="https://github.com/EveSunMaple/astion-static">Astion</a>{" "}
        (a Notion-powered blog template) and <a href="https://github.com/EveSunMaple/Frosti">Frosti</a>{" "}
        (a static blog template), both built with Astro.
      </p>
      <p>
        I love contributing to open source and building tools that help people publish beautiful
        content without fighting their toolchain.
      </p>

      <h2>Projects</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          projects.map((project) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <Icon name="ri:github-line" class="doc-tile-icon" />
              <span class="min-w-0">
                <span class="doc-tile-title block">{project.name}</span>
                <span class="doc-tile-description block">{project.description}</span>
              </span>
            </a>
          ))
        }
      </div>

      <h2>Stack</h2>
      <div class="flex flex-wrap gap-1.5">
        {stack.map((item) => <span class="pill">{item}</span>)}
      </div>

      <h2>Links</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="doc-tile">
              <Icon name={link.icon} class="doc-tile-icon" />
              <span class="min-w-0">
                <span class="doc-tile-title block">{link.label}</span>
                <span class="doc-tile-description block truncate">{link.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </MainCard>
</BaseLayout>
