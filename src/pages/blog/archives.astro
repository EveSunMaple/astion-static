---
import BaseCard from "@components/BaseCard.astro";
import { DATE_FORMAT, t } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getAllPosts,
  getPostSlug,
  getPostsByYearAndMonth,
  sortPostsByDate,
} from "@utils/blogUtils";
import dayjs from "@utils/dayjs";
import { Icon } from "astro-icon/components";

// 获取所有博客文章
const allPosts = await getAllPosts();

// 按日期排序
const sortedPosts = sortPostsByDate(allPosts);

// 按年份和月份分组
const postsByDate = getPostsByYearAndMonth(sortedPosts);

// 转换为数组并按年份排序（降序）和月份（降序）
const years = Array.from(postsByDate.keys()).sort(
  (a, b) => parseInt(b, 10) - parseInt(a, 10),
);

// 从翻译获取月份名称
const getMonthName = (month: string): string => {
  const monthIndex = parseInt(month, 10);
  return t(`months.${monthIndex}`);
};

// 统计总文章数
const totalPosts = allPosts.length;
---

<BaseLayout title={t("label.archivePage")}>
  <BaseCard title={t("label.archivePage")}>
    <div class="page-header flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div class="flex items-center gap-2">
        <Icon name="lucide:archive" class="h-5 w-5 text-meta" />
        <h1 id="h1" class="page-header-title">{t("label.archivePage")}</h1>
        <div class="pill">{totalPosts} {totalPosts === 1 ? t("label.post") : t("label.posts")}</div>
      </div>
      <a href="/blog" class="button gap-1.5" data-variant="secondary" data-size="sm">
        <Icon name="lucide:book-open" class="h-4 w-4" />
        <span>{t("label.backToBlog")}</span>
      </a>
    </div>
    <div class="my-2 border-t border-line-soft"></div>
    <p class="page-header-description">{t("label.archivesPageDescription")}</p>
  </BaseCard>
  <BaseCard title={t("label.archivePage")}>
    <div class="archives-container">
      {
        years.length > 0 ? (
          <div class="archives-timeline">
            {years.map((year) => (
              <div class="timeline-year">
                <div class="year-header">
                  <div class="year-badge">{year}</div>
                </div>

                <div class="year-content">
                  {Array.from(postsByDate.get(year)!.entries())
                    .sort((a, b) => parseInt(b[0], 10) - parseInt(a[0], 10))
                    .map(([month, posts]) => (
                      <div class="timeline-month">
                        <h3 class="month-title">
                          <Icon name="lucide:calendar" class="month-icon" />
                          <span>
                            {getMonthName(month)} {year}
                          </span>
                          <span class="month-count">{posts.length}</span>
                        </h3>

                        <ul class="archive-posts">
                          {posts.map((post) => (
                            <li class="archive-item">
                              <a href={`/blog/${getPostSlug(post)}`} class="archive-card">
                                <time class="archive-date">{dayjs(post.data.pubDate).format(DATE_FORMAT)}</time>
                                <h4 class="archive-title">{post.data.title}</h4>
                                {post.data.description && <p class="archive-description">{post.data.description}</p>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <Icon name="ri:emotion-sad-line" class="empty-icon" />
            <p class="empty-text">{t("label.noPosts")}</p>
          </div>
        )
      }
    </div>
  </BaseCard>
</BaseLayout>
