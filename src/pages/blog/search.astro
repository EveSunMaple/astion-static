---
import BaseCard from "@components/BaseCard.astro";
import { t } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import "@pagefind/default-ui/css/ui.css";
---

<BaseLayout title={t("label.searchPage")}>
  <BaseCard title={t("label.searchPage")}>
    <div class="page-header flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div class="flex items-center gap-2">
        <Icon name="lucide:search" class="w-6 h-6 text-base-content/50" />
        <h1 id="h1" class="page-header-title">{t("label.searchPage")}</h1>
      </div>
      <a href="/blog" class="btn btn-ghost btn-sm gap-2">
        <Icon name="lucide:book-open" class="w-4 h-4" />
        <span>{t("label.backToBlog")}</span>
      </a>
    </div>
    <p class="page-header-description">{t("label.searchPageDescription")}</p>
  </BaseCard>

  <BaseCard>
    <div id="search-container" class="w-full">
      <div id="pagefind-search"></div>
    </div>
  </BaseCard>
</BaseLayout>
