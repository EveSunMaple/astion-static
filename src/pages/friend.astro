---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const friends = [
  {
    name: "Lyme Blurred",
    description:
      "Building, breaking, and learning daily | A copy of EveSunMaple",
    url: "https://github.com/lymeblurred",
    avatar: "https://github.com/lymeblurred.png",
  },
  {
    name: "梦凌汐",
    description: "来自星辰边缘的猫猫~爱好是睡觉awa",
    url: "https://github.com/MeowLynxSea",
    avatar: "https://github.com/MeowLynxSea.png",
  },
  {
    name: "颜涂楷睿",
    description: "你好，我是雪狐~",
    url: "https://github.com/SnowFoxqwq",
    avatar: "https://github.com/SnowFoxqwq.png",
  },
];

const contributors = [
  {
    name: "EveSunMaple",
    description: "Coding is my hobby, not my career.",
    url: "https://github.com/EveSunMaple",
  },
  {
    name: "Loping151",
    description: "Loping151",
    url: "https://github.com/Loping151",
  },
  {
    name: "Tianxiang Roxiyater",
    description: "明日尚未到来，希望凝于心上",
    url: "https://github.com/TNXG",
  },
  {
    name: "Yaoqx",
    description: "A lazy junior high school student who likes coding!",
    url: "https://github.com/YaoqxCN",
  },
  {
    name: "Yao Tutu",
    description: "Graduated student of SHMTU, CS major.",
    url: "https://github.com/yaotutu",
  },
  {
    name: "WRXinYue",
    description: "Technology is not just a tool; it is a joy and an art.",
    url: "https://github.com/WRXinYue",
  },
  {
    name: "龙一",
    description: "linglilongyi",
    url: "https://github.com/linglilongyi",
  },
  {
    name: "Youngestar",
    description: "Just go ahead!",
    url: "https://github.com/youngestar",
  },
  { name: "Liks", description: "Liks", url: "https://github.com/Liksone" },
];

const resources = [
  {
    title: "Astro Documentation",
    description: "Everything from getting started to advanced techniques.",
    url: "https://docs.astro.build",
  },
  {
    title: "Tailwind CSS Documentation",
    description: "Style your website with utility classes.",
    url: "https://tailwindcss.com/docs",
  },
  {
    title: "DaisyUI Components",
    description: "Component library built on top of Tailwind CSS.",
    url: "https://daisyui.com/components/",
  },
  {
    title: "TypeScript Handbook",
    description: "A comprehensive guide to the TypeScript language.",
    url: "https://www.typescriptlang.org/docs/handbook/intro.html",
  },
];

const sites = [
  { name: "Astion Demo", url: "https://demo.shuoshuo.saroprock.com/" },
  { name: "Frosti Demo", url: "https://frosti.saroprock.com/" },
];
---

<BaseLayout title="Friends">
  <MainCard
    title="Friends & Resources"
    icon="🤝"
    description="A collection of links to friends, contributors and useful resources."
  >
    <div class="notion-content">
      <h2>Friends</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          friends.map((friend) => (
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <img
                src={friend.avatar}
                alt={friend.name}
                width="20"
                height="20"
                loading="lazy"
                class="doc-tile-icon rounded-full"
              />
              <span class="min-w-0">
                <span class="doc-tile-title block">{friend.name}</span>
                <span class="doc-tile-description block">{friend.description}</span>
              </span>
            </a>
          ))
        }
      </div>

      <h2>Contributors</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          contributors.map((contributor) => (
            <a
              href={contributor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <img
                src={`https://github.com/${contributor.url.split("/").pop()}.png`}
                alt={contributor.name}
                width="20"
                height="20"
                loading="lazy"
                class="doc-tile-icon rounded-full"
              />
              <span class="min-w-0">
                <span class="doc-tile-title block">{contributor.name}</span>
                <span class="doc-tile-description block">{contributor.description}</span>
              </span>
            </a>
          ))
        }
      </div>

      <h2>Useful resources</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          resources.map((resource) => (
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <Icon name="ri:bookmark-line" class="doc-tile-icon" />
              <span class="min-w-0">
                <span class="doc-tile-title block">{resource.title}</span>
                <span class="doc-tile-description block">{resource.description}</span>
              </span>
            </a>
          ))
        }
      </div>

      <h2>Sites using Astion</h2>
      <p>
        A list of sites built with Astion. Want to get your site listed?
        <a
          href="https://github.com/EveSunMaple/astion-static/edit/main/src/pages/friend.astro"
          target="_blank"
          rel="noopener noreferrer">Edit this page</a
        > and submit a pull request.
      </p>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          sites.map((site) => (
            <a
              href={site.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <Icon name="ri:global-line" class="doc-tile-icon" />
              <span class="min-w-0">
                <span class="doc-tile-title block">{site.name}</span>
                <span class="doc-tile-description block truncate">{site.url}</span>
              </span>
            </a>
          ))
        }
      </div>

      <hr />
      <p>
        Want to be featured on this page?
        <a
          href="https://github.com/EveSunMaple/astion-static"
          target="_blank"
          rel="noopener noreferrer">Contribute on GitHub</a
        >.
      </p>
    </div>
  </MainCard>
</BaseLayout>
