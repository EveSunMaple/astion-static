---
import PostCard from "@components/PostCard.astro";
import CardGroup from "@components/temple/CardGroup.astro";
import { FEED_DESCRIPTION, FEED_TITLE, t } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getAllShuoshuo,
  getPostSlug,
  getPostsWithStats,
  sortPostsByDate,
} from "@utils/blogUtils";
import { Icon } from "astro-icon/components";

const posts = await getAllShuoshuo();
const postsWithStats = await getPostsWithStats(sortPostsByDate(posts));
---

<BaseLayout title="Home">
  <header class="page-header flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-header-title">{FEED_TITLE}</h1>
      <p class="page-header-description">{FEED_DESCRIPTION}</p>
    </div>
    <a href="/blog" class="btn btn-ghost btn-sm gap-1">
      <Icon name="lucide:book-open" class="h-4 w-4" />
      <span>{t("label.blogPage")}</span>
    </a>
  </header>

  {
    postsWithStats.length > 0 ? (
      <CardGroup cols="1">
        {postsWithStats.map((post, index) => (
          <PostCard
            priority={index === 0}
            title={post.data.title}
            image={post.data.image}
            description={post.data.description}
            url={"/post/" + getPostSlug(post)}
            pubDate={post.data.pubDate}
            badge={post.data.badge}
            categories={post.data.categories}
            tags={post.data.tags}
            word={post.remarkPluginFrontmatter.totalCharCount}
            time={post.remarkPluginFrontmatter.readingTime}
          />
        ))}
      </CardGroup>
    ) : (
      <div class="empty-state">
        <Icon name="ri:emotion-sad-line" class="empty-icon" />
        <p class="empty-text">{t("label.noPosts")}</p>
      </div>
    )
  }
</BaseLayout>
