---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import PostFilter from "@components/widgets/PostFilter.astro";
import PostInfo from "@components/widgets/PostInfo.astro";
import { DATE_FORMAT } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  computeReadingStats,
  getAllShuoshuo,
  getPostSlug,
} from "@utils/blogUtils";
import dayjs from "@utils/dayjs";
import MainCard from "@/components/MainCard.astro";

export async function getStaticPaths() {
  const posts = await getAllShuoshuo();

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const slug = getPostSlug(post);
const { Content, headings } = await render(post);
const displayDate = post.data.pubDate
  ? dayjs(post.data.pubDate).format(DATE_FORMAT)
  : "";
const image = new URL(`/og/${slug}.png`, Astro.site).toString();
const stats = computeReadingStats(
  (post as unknown as { rendered?: { html?: string } }).rendered?.html ?? "",
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  headings={headings}
  showTOC={true}
  ogType="article"
  pubDate={post.data.pubDate}
>
  <MainCard title={post.data.title} description={post.data.description} image={post.data.image} infoIcon="lucide:info">
    <PostInfo
      pubDate={displayDate}
      badge={post.data.badge}
      word={stats.totalCharCount}
      time={stats.readingTime}
    />

    <div class="mb-6">
      <PostFilter categories={post.data.categories} tags={post.data.tags} />
    </div>

    <div class="mt-8">
      <div id="content" class="notion-content max-w-none">
        <Content />
      </div>
    </div>
  </MainCard>
</BaseLayout>
