---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const repos = [
  {
    name: "astion-static",
    description: "A Notion-powered blog template built with Astro.",
    url: "https://github.com/EveSunMaple/astion-static",
    pinned: true,
  },
  {
    name: "Frosti",
    description:
      "A clean, elegant, and fast static blog template built with Astro.",
    url: "https://github.com/EveSunMaple/Frosti",
    pinned: true,
  },
  {
    name: "SaroProck",
    description: "我的个人博客（Astro + React）。",
    url: "https://github.com/EveSunMaple/SaroProck",
  },
  {
    name: "rehype-smart-links",
    description:
      "A rehype plugin that styles internal and external links differently.",
    url: "https://github.com/EveSunMaple/rehype-smart-links",
  },
  {
    name: "astro-update-theme",
    description: "A CLI program written in C++ for updating Astro themes.",
    url: "https://github.com/EveSunMaple/astro-update-theme",
  },
  {
    name: "Word-testing-application",
    description: "一个用 Python + Tkinter 制作的单词测试应用。",
    url: "https://github.com/EveSunMaple/Word-testing-application",
  },
];
---

<BaseLayout title="Projects">
  <MainCard
    title="Projects"
    icon="ri:code-box-line"
    description="A selection of open-source projects and experiments."
  >
    <div class="notion-content">
      <h2>Featured</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          repos
            .filter((repo) => repo.pinned)
            .map((repo) => (
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="doc-tile"
              >
                <Icon name="ri:github-line" class="doc-tile-icon" />
                <span class="min-w-0">
                  <span class="doc-tile-title block">{repo.name}</span>
                  <span class="doc-tile-description block">{repo.description}</span>
                </span>
              </a>
            ))
        }
      </div>

      <h2>All repositories</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          repos.map((repo) => (
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-tile"
            >
              <Icon name="ri:git-repository-line" class="doc-tile-icon" />
              <span class="min-w-0">
                <span class="doc-tile-title block">{repo.name}</span>
                <span class="doc-tile-description block">{repo.description}</span>
              </span>
            </a>
          ))
        }
      </div>

      <p>
        <a
          href="https://github.com/EveSunMaple?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
        >
          View more on GitHub →
        </a>
      </p>
    </div>
  </MainCard>
</BaseLayout>
